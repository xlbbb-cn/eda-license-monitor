{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "监控中的 License Server",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [
        {
          "expr": "count(flexlm_server_status)",
          "legendFormat": "Servers",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "License 总数",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      },
      "targets": [
        {
          "expr": "sum(flexlm_feature_total)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "当前已使用",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "orange", "value": null }] } }
      },
      "targets": [
        {
          "expr": "sum(flexlm_feature_used)",
          "legendFormat": "Used",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "总体使用率",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "orange", "value": 0.85 },
              { "color": "red", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(flexlm_feature_used) / sum(flexlm_feature_total)",
          "legendFormat": "Usage",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "活跃 Features",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "purple", "value": null }] } }
      },
      "targets": [
        {
          "expr": "(count(flexlm_feature_used > 0) or count(flexlm_feature_used) * 0)",
          "legendFormat": "Active",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "告警状态",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "count(flexlm_feature_used >= flexlm_feature_total) or vector(0)",
          "legendFormat": "Full Features",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "各 Feature 使用详情",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "使用率" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge" }
              },
              { "id": "thresholds", "value": {
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.7 },
                  { "color": "red", "value": 0.9 }
                ]
              }}
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "使用率", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Feature",
              "Value #B": "总数",
              "Value #C": "已使用",
              "Value #D": "使用率",
              "Value #E": "用户数"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "flexlm_feature_total",
          "legendFormat": "{{ feature }}",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "flexlm_feature_used",
          "legendFormat": "{{ feature }}",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "flexlm_feature_used / flexlm_feature_total",
          "legendFormat": "{{ feature }}",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "expr": "flexlm_feature_users",
          "legendFormat": "{{ feature }}",
          "refId": "E",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "各 Feature 使用率趋势 (24h)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": true }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "flexlm_feature_used / flexlm_feature_total",
          "legendFormat": "{{ server }} / {{ feature }}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["eda", "license", "flexlm"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "EDA License Overview",
  "uid": "eda-license-overview",
  "version": 2
}
